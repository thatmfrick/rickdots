theme = kanagawa-dragon
font-family = "CaskaydiaCove Nerd Font"
font-style = bold
font-size = 16
gtk-titlebar = false
background-opacity= 0.9
cursor-opacity = 0.5
cursor-color = #8094B4
cursor-style = block
shell-integration-features = no-cursor
link-previews = true
custom-shader = shaders/cursor_warp.glsl
