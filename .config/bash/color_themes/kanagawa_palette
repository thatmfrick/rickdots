#!/usr/bin/env bash

prompt_theme() {
    local \
        lines_c exitcode_c \
        user_c host_c \
        cwd_c branch_c prompt_c

    lines_c=$'\e[38;2;158;155;147m'
    exitcode_c=$'\e[38;2;232;36;36m'
    user_c=$'\e[38;2;182;146;123m'
    host_c=$'\e[38;2;162;146;163m'
    cwd_c=$'\e[38;2;138;154;123m'
    branch_c=$'\e[38;2;228;104;118m'
    prompt_c=$'\e[38;2;230;195;132m'

    echo "$lines_c|$exitcode_c|$user_c|$host_c|$cwd_c|$branch_c|$prompt_c"
}
